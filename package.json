{
  "description": "Sign and verify HTTP messages per RFC 9421 (ed25519 / hmac-sha256), with RFC 9530 Content-Digest body binding",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "http-signatures",
    "rfc9421",
    "ed25519",
    "api-security"
  ],
  "license": "MIT",
  "main": "dist/src/index.js",
  "name": "@toniadreal/rfc9421-signing-demo",
  "scripts": {
    "bench": "npm run build && node dist/bench/bench.js",
    "build": "tsc",
    "demo": "npm run build && node dist/src/demo.js",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "version": "0.1.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToniAdreal/rfc9421-signing-demo.git"
  },
  "files": [
    "dist"
  ]
}
